# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aisemester

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# RAG
RETRIEVAL_TOP_K=10

# App
CORS_ORIGINS=["http://localhost:3000"]
